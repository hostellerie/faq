{block_start}
<div class="faq-public faq-categories">
  <ul class="faq-category-list">
    {faq_cat_list_item}
  </ul>
</div>
{block_end}

<!-- BEGIN cat_list_item -->
<li class="faq-category-card">
  <h2><a href="{faq_cat_url}">{faq_cat_title}</a></h2>
  <div class="faq-category-description">{faq_cat_desc}</div>
  <div class="faq-card-meta">
    <span>{faq_cat_faqs_label}: {faq_cat_faqs}</span>
    <span>{faq_hits_label}: {faq_cat_hits}</span>
  </div>
</li>
<!-- END cat_list_item -->
