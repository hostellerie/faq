<form action="{site_admin_url}/plugins/faq/index.php" method="get" class="faq-admin-toolbar">
  <input type="hidden" name="mode" value="faq">
  <label for="faq-category-filter">{faq_lang_category}</label>
  <select id="faq-category-filter" name="cat">
    <option value="">{faq_lang_all}</option>
    {faq_category_options}
  </select>
  <input type="submit" name="action" value="{faq_lang_show}">
</form>
