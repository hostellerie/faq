<form action="{site_admin_url}/plugins/faq/index.php" method="post" onsubmit="set_postcontent();" class="compact uk-form">
<input type="hidden" name="mode" value="cat">
<input type="hidden" id="faq_desc_edited" name="faq_desc_edited" value="0">

<div class="admin_basic">
<dl class="form_block">
<dt><label for="faq-editor-id">{faq_lang_id}</label></dt>
<dd><input type="text" size="40" maxlength="40" id="faq-editor-id" name="faq_id" value="{faq_id}" class="size5"></dd>

<dt><label for="faq-editor-title">{faq_lang_title}</label></dt>
<dd><input type="text" size="69" maxlength="250" id="faq-editor-title" name="faq_title" value="{faq_title}" class="size5"></dd>

<dt><label for="sel_editmode">{lang_editor_mode}</label></dt>
<dd>
<select id="sel_editmode" name="faq_editor_mode" onchange="change_editmode(this);">
{editor_mode_options}
</select>
</dd>

<dt><label>{faq_lang_desc}</label></dt>
<dd class="faq-content-editor">
<div id="faq_editor_toolbar" class="faq-editor-controls" style="display:{show_adveditor};">
<label for="adveditor_toolbar_selector">{lang_toolbar}</label>
<select id="adveditor_toolbar_selector" onchange="changeToolbar(this.value);">
<option value="editor-toolbar1">{toolbar1}</option>
<option value="editor-toolbar2" selected="selected">{toolbar2}</option>
<option value="editor-toolbar3">{toolbar3}</option>
<option value="Default">{toolbar_full}</option>
</select>
{media_picker_button}
</div>

<div id="faq_advanced_editarea" style="display:{show_adveditor};">
<textarea id="faq_desc_advanced" cols="60" rows="20">{faq_desc}</textarea>
</div>

<div id="faq_html_editarea" style="display:{show_htmleditor};">
<textarea id="faq_desc_source" name="faq_desc" cols="60" rows="20" wrap="virtual">{faq_desc}</textarea>
<div class="warningsmall faq-editor-note">{lang_allowed_html}</div>
{media_picker_button_source}
</div>
</dd>

</dl>

<hr>
<h3>{lang_accessrights}</h3>
<dl class="form_block">
<dt>{lang_owner}</dt>
<dd>{owner_username}<input type="hidden" name="owner_id" value="{faq_ownerid}"></dd>
<dt>{lang_group}</dt>
<dd>{group_dropdown}</dd>
<dt>{lang_permissions}</dt>
<dd>{permissions_editor}</dd>
<dd class="description">{lang_permissionskey}</dd>
<dd class="description">{lang_lockmsg}</dd>
</dl>

<p>
<input type="submit" value="{lang_save}" name="action">
<input type="submit" value="{lang_cancel}" name="action">
{delete_option}
<input type="hidden" value="{faq_id}" name="faq_old_id">
</p>
</div>
</form>
